# Main provider options:
# kaznu | groq | auto
LLM_PROVIDER=kaznu

# KazNU OpenAI-compatible endpoint
AGENT_BASE_URL=https://farabi-inference.kaznu.kz/v1
AGENT_MODEL=Qwen/Qwen3.5-9B
AGENT_FALLBACK_MODEL=Qwen/Qwen3.5-9B
AGENT_API_KEY=your_kaznu_api_key_here

# GROQ backup provider
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant